{
  "name": "t-office-tests",
  "version": "1.0.0",
  "description": "Test scripts for T-Office application",
  "main": "run_tests.js",
  "type": "module",
  "scripts": {
    "test:signup": "node user_signup.test.js",
    "test:cleanup": "node user_cleanup.test.js",
    "test:both": "node run_tests.js both",
    
    "test:setup:admin": "node auth/create_admin_user.js",
    
    "test:users:roles": "node users/create_extra_roles.js",
    "test:users:create": "node users/multi_user_creation.js",
    "test:users:support": "node users/support_staff_allocation.js",
    "test:users:all": "node run_user_tests.js",
    "cleanup:users": "node users/cleanup_multi_users.js",
    
    "test:inventory": "node run_inventory_tests.js",
    "test:inventory:all": "node run_inventory_tests.js",
    "test:inventory:providers": "node inventory/create_providers.test.js",
    "test:inventory:products": "node inventory/create_products.test.js",
