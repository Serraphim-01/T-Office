{
  "rewrites": [
    {
      "source": "/app-manifest.json",
      "destination": "/manifest.json"
    }
  ],
  "headers": [
    {
      "source": "/app-manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
